# Contact form (app/actions/contact.ts). Sends through Resend: https://resend.com
# Without RESEND_API_KEY the form tells visitors to email directly.
RESEND_API_KEY=
# Optional. Defaults to site.email. Resend's shared sender (onboarding@resend.dev)
# can only deliver to the address on your Resend account, so keep these the same
# until you verify your own domain.
CONTACT_TO=
# Optional. Defaults to "Portfolio <onboarding@resend.dev>"; set to an address on
# your verified domain once you have one, e.g. "Portfolio <hello@yourdomain.com>".
CONTACT_FROM=

# Public site URL, used for metadata and the sitemap. Vercel's production host is
# used automatically when this is unset.
NEXT_PUBLIC_SITE_URL=
